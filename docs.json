{
  "$schema": "https://mintlify.com/docs.json",
  "theme": "mint",
  "name": "Mermail",
  "colors": {
    "primary": "#1E40AF",
    "light": "#70EEEE",
    "dark": "#3C91FF"
  },
  "favicon": "/favicon.ico",
  "navigation": {
    "pages": [
      {
        "group": "Get started",
        "pages": [
          "index",
          "quickstart"
        ]
      },
      {
        "group": "Core concepts",
        "pages": [
          "concepts/mailboxes",
          "concepts/workspaces",
          "concepts/ai-agent",
          "concepts/task-triage"
        ]
      },
      {
        "group": "Guides",
        "pages": [
          "guides/create-mailbox",
          "guides/custom-domains"
        ]
      },
      {
        "group": "Integrations",
        "pages": [
          "integrations/composio",
          "integrations/telegram"
        ]
      },
      {
        "group": "API and discovery",
        "pages": [
          "api-reference/overview",
          "api-reference/discovery",
          "api-reference/authentication"
        ]
      },
      {
        "group": "Resources",
        "pages": [
          "resources/faq",
          "resources/support",
          "resources/security",
          "resources/plans"
        ]
      }
    ],
    "global": {
      "anchors": [
        {
          "anchor": "Console",
          "href": "https://console.mermail.app",
          "icon": "inbox"
        },
        {
          "anchor": "Website",
          "href": "https://mermail.app",
          "icon": "globe"
        }
      ]
    }
  },
  "logo": {
    "light": "/logo/light.svg",
    "dark": "/logo/dark.svg"
  },
  "navbar": {
    "links": [
      {
        "label": "Support",
        "href": "mailto:contact@mermail.app"
      }
    ],
    "primary": {
      "type": "button",
      "label": "Open console",
      "href": "https://console.mermail.app"
    }
  },
  "contextual": {
    "options": [
      "copy",
      "view",
      "chatgpt",
      "claude",
      "perplexity",
      "mcp",
      "cursor",
      "vscode"
    ]
  }
}
