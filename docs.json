{
  "$schema": "https://mintlify.com/docs.json",
  "theme": "mint",
  "name": "Mermail",
  "colors": {
    "primary": "#43c9cb",
    "light": "#43c9cb",
    "dark": "#43c9cb"
  },
  "favicon": "/mermail-favicon.png",
  "navigation": {
    "tabs": [
      {
        "tab": "Documentation",
        "icon": "book-open",
        "groups": [
          {
            "group": "Get started",
            "pages": [
              "index",
              "quickstart"
            ]
          },
          {
            "group": "Core concepts",
            "pages": [
              "concepts/mailboxes",
              "concepts/workspaces",
              "concepts/ai-agent",
              "concepts/task-triage"
            ]
          },
          {
            "group": "Guides",
            "pages": [
              "guides/create-mailbox",
              "guides/custom-domains",
              "api-reference/authentication",
              "api-reference/discovery"
            ]
          },
          {
            "group": "Integrations",
            "pages": [
              "integrations/composio",
              "integrations/telegram"
            ]
          },
          {
            "group": "Resources",
            "pages": [
              "resources/faq",
              "resources/support",
              "resources/security",
              "resources/plans"
            ]
          }
        ]
      },
      {
        "tab": "API Reference",
        "icon": "square-terminal",
        "pages": [
          "api-reference/overview"
        ]
      }
    ],
    "global": {
      "anchors": [
        {
          "anchor": "Console",
          "href": "https://console.mermail.app",
          "icon": "inbox"
        },
        {
          "anchor": "Website",
          "href": "https://mermail.app",
          "icon": "globe"
        }
      ]
    }
  },
  "logo": {
    "light": "/logo/light.svg",
    "dark": "/logo/dark.svg"
  },
  "navbar": {
    "links": [
      {
        "label": "Support",
        "href": "mailto:contact@mermail.app"
      }
    ],
    "primary": {
      "type": "button",
      "label": "Open console",
      "href": "https://console.mermail.app"
    }
  },
  "contextual": {
    "options": [
      "copy",
      "view",
      "chatgpt",
      "claude",
      "perplexity",
      "mcp",
      "cursor",
      "vscode"
    ]
  }
}
